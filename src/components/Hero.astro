---
import { site } from '../data/site';
---
<section class="hero" aria-labelledby="hero-heading">
  <div class="hero-meta micro"><span>{site.role}</span><span>Portfolio / 2026</span></div>
  <h1 id="hero-heading">Making complex workflows<br class="desktop-break" /> easier to <em>understand.</em></h1>
  <div class="hero-bottom">
    <div><p>I’m {site.name}, a UX / Product Designer completing my B.A. in Experience Architecture at Michigan State University. I connect workflow evaluation, information architecture, and interaction design, with attention to accessibility and how interfaces are built.</p></div>
    <a class="text-link" href="#work">Explore selected work <span aria-hidden="true">↘</span></a>
  </div>
</section>
