---
import { site } from '../data/site';
import SectionHeading from './SectionHeading.astro';
---
<section id="contact" class="section contact-section" aria-labelledby="contact-heading">
  <SectionHeading number="04" title="Let’s connect." id="contact-heading" />
  <div class="contact-bottom">
    <p>{site.email ? 'For conversations about UX, product design, and thoughtful digital experiences.' : 'Email details are awaiting owner approval for this review. You can explore my work and the portfolio’s review history on GitHub.'}</p>
    {site.email ? <a class="text-link" href={`mailto:${site.email}`}>Email {site.name} <span aria-hidden="true">↗</span></a> : <a class="text-link" href={site.github}>View GitHub profile <span aria-hidden="true">↗</span></a>}
    {site.linkedIn && <a class="text-link" href={site.linkedIn}>LinkedIn <span aria-hidden="true">↗</span></a>}
  </div>
</section>
