---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CaseOverview from '../../components/case-study/CaseOverview.astro';
import NextProject from '../../components/case-study/NextProject.astro';
import ProcessSection from '../../components/case-study/ProcessSection.astro';
import ArtifactFigure from '../../components/case-study/ArtifactFigure.astro';
import DesignComparison from '../../components/case-study/DesignComparison.astro';
import GuidedJourney from '../../components/case-study/GuidedJourney.astro';
import { communityJourney } from '../../data/community-journey';
import '../../styles/community.css';
import HeroShowcase from '../../components/case-study/HeroShowcase.astro';
import { communityAssets } from '../../data/community-spaces-assets';
import '../../styles/case-study.css';

export async function getStaticPaths() {
  // Only this explicitly commissioned review case study is routable. Other drafts stay out.
  const projects = await getCollection('projects', ({ id, data }) => id === 'community-spaces' && data.publicationStatus === 'review' && Boolean(data.caseStudy));
  return projects.map((project) => ({ params: { slug: project.data.caseStudy!.slug }, props: { project } }));
}
interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props;
const cs = project.data.caseStudy!;
const root = import.meta.env.BASE_URL;
---
<BaseLayout title="Community Spaces — Collaborative UX case study" description="A collaborative GD 491 class concept for a community space and event-registration app. Authentic team artifacts, reported class research, and proposed next steps; review only.">
  <div id="top"><SiteHeader />
    <main id="main" class="container case-study community-case" tabindex="-1">
      <div class="case-intro"><header class="case-hero"><a class="case-back" href={`${root}#work`}>← Back to selected work</a><p class="micro">{cs.context} / UX & interaction design</p><h1>{project.data.title}</h1><p class="case-deck">{cs.headline}</p><p class="case-scope">{cs.introduction}</p></header>
      <HeroShowcase />
      </div>
      <CaseOverview items={[
        { label: 'Problem', value: 'Connecting a place to gather with a way to discover and join events.' },
        { label: 'Methods', value: 'Interviews, user-need synthesis, task mapping, sketches, and wireframes.' },
        { label: 'Deliverable', value: 'A proposed physical space and KIBS interface concepts.' },
        { label: 'Team', value: cs.team.join(', ') },
        { label: 'My contribution', value: cs.role },
        { label: 'Status', value: 'Concept and prototype · Not launched · Review only' },
      ]} />
      <p class="project-status"><strong>Project status.</strong> University concept and prototype; not launched. Usability evaluation is proposed. Research findings are reported from the class project. The portfolio walkthrough presents original interface states, not verified prototype connections or working registration. Dates, counts, and availability in the original screens are illustrative.</p>
      <nav class="case-toc" aria-label="Case study sections"><p class="micro">In this case study</p><ul>{cs.sections.map((section) => <li><a href={`#${section.id}`}>{section.kicker.replace(/^\d+ \/ /, '')}</a></li>)}</ul></nav>
      {cs.sections.map((section) => <ProcessSection {...section}>
        {section.id === 'research' && <>
          <div class="community-needs">
            <article id="need-space"><h3>A place to study and connect.</h3><p><strong>Documented need.</strong> A place to study and build relationships.</p><p><strong>Concept response.</strong> Spatial sketches explore seating, study areas, and gathering spaces.</p><p><strong>Evaluation question.</strong> How could different activities coexist without conflicting?</p><a href="#experience">Explore the physical and digital relationship →</a></article>
            <article id="need-dates"><h3>Information to plan a visit.</h3><p><strong>Documented need.</strong> Event availability on specific dates.</p><p><strong>Concept response.</strong> Dated event entries and event information.</p><p><strong>Evaluation question.</strong> Can people find an activity that fits their schedule?</p><a href="#journey-discover">Inspect event discovery →</a></article>
            <article id="need-participation"><h3>A path to participation.</h3><p><strong>Documented task.</strong> Finding an event and signing up.</p><p><strong>Concept response.</strong> Event details, reservation, and confirmation concepts.</p><p><strong>Evaluation question.</strong> Do people understand the requirements and what registration means?</p><a href="#journey-reserve">Inspect registration requirements →</a></article>
          </div>
          <p class="source-note community-research-note">The class presentation also reported that ≈9 of 12 participants wanted more music or concert-related entertainment. This is contextual class research, not a population-level statistic or evidence of a concert-specific feature. The connections above are interpretations supported by the materials, not a reconstructed decision log.</p>
        </>}
        {section.id === 'experience' && <div class="experience-pair"><div><h3>The space gives participation a setting.</h3><ul><li>Study areas</li><li>Event spaces</li><li>Community interaction</li><li>Proposed Sparty Market</li></ul></div><div><h3>The app helps people plan participation.</h3><ol class="service-journey"><li>Discover an event</li><li>Review the details</li><li>Register to attend</li><li>Intended visit to the proposed space</li></ol><p class="source-note">An explanatory view of the team’s concept—not a built service or observed attendance journey.</p></div></div>}


        {section.media.includes('space') && <ArtifactFigure asset={communityAssets.space} />}
        {section.media.includes('flow') && <details class="community-task-flow"><summary>Original event-registration task flow</summary><p>Login → home → events → event details → signup → double-check → confirmation. History, the market, and shopping cart branch from home in the original task map.</p><ArtifactFigure asset={communityAssets.flow} /></details>}
        {section.media.includes('sketch') && <ArtifactFigure asset={communityAssets.sketch} />}
        {section.media.includes('comparison') && <DesignComparison before={communityAssets.midEvents} after={communityAssets.events} beforeLabel="01 / Structure" afterLabel="02 / Visual development" />}
        {section.media.includes('screens') && <GuidedJourney steps={communityJourney} fileKey="pWjqzjZD2HgayCk6pQg3Zk" navLabel="Community journey steps" fileName="Wireframes" layout="portrait" />}
        {section.id === 'reflection' && <div class="next-priorities" aria-label="Proposed next steps"><div><h3>Validate the journey</h3><p>Test event discovery, registration, and confirmation with potential users.</p></div><div><h3>Evaluate accessibility</h3><p>Review navigation, contrast, screen-reader support, and interaction targets.</p></div><div><h3>Explore real-world scenarios</h3><p>Consider canceled events, capacity limits, and whether users should be able to browse without logging in.</p><p>The confirmation concept includes a “Continue Shopping” action. Future evaluation should examine whether that wording fits event registration and makes the next step clear.</p></div></div>}
      </ProcessSection>)}
      <section id="sources" class="case-sources" aria-labelledby="sources-heading"><p class="micro">Source notes / Credits</p><h2 id="sources-heading">Project Credits &amp; Resources</h2><p>Community Spaces was developed collaboratively by Katelyn Jewett, Illiana Gonzalez, Boran Erdogan, and Suleyman Koncagul as a GD 491 final project at Michigan State University. All four teammates worked together throughout the process.</p><ul><li><a href="https://www.figma.com/design/pWjqzjZD2HgayCk6pQg3Zk/Wireframes?node-id=154-64">Original wireframes and high-fidelity designs in Figma</a></li><li><a href="https://www.figma.com/design/STtzkQ9AyK3krzZihxnXxt/User-Needs---Concept-Statements?node-id=0-1">Original user needs and concept statements in Figma</a></li><li>Final class presentation: <cite>GD 491 Case Study for Community Spaces</cite>, 17 pages, supplied by the owner. Selected project artifacts reproduced on this page.</li></ul><p class="source-note">Presentation template credits: Slidesgo, Flaticon, and Freepik. Rights to photos and icons embedded in the original screens remain subject to review before public launch.</p><a class="text-link" href={`${root}#work`}>Back to selected work <span aria-hidden="true">↗</span></a></section>
      <NextProject slug="d2l-redesign" title="D2L Redesign" description="Evaluating coursework workflows and exploring assignment review and submission states." />
    </main><SiteFooter />
  </div>
</BaseLayout>
