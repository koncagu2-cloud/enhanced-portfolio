---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ProjectMetadata from '../../components/case-study/ProjectMetadata.astro';
import ProcessSection from '../../components/case-study/ProcessSection.astro';
import ArtifactFigure from '../../components/case-study/ArtifactFigure.astro';
import DesktopPair from '../../components/d2l/DesktopPair.astro';
import { d2lAssets as assets } from '../../data/d2l-assets';
import '../../styles/case-study.css';
import '../../styles/d2l.css';
const project = await getEntry('projects', 'd2l');
if (!project?.data.caseStudy || project.data.publicationStatus !== 'review') throw new Error('D2L review content is required.');
const cs = project.data.caseStudy;
const root = import.meta.env.BASE_URL;
const source = (node: string) => `https://www.figma.com/design/piRHnDp4bwoVkKMo1mHSt7/Team--1?node-id=${node.replace(':', '-')}`;
const findings = [
  { number: '01', title: 'Where am I in this course?', issue: 'The evaluation noted missing current-page cues and differences between course layouts.', response: 'Explore repeated navigation labels, a visible current section, and named assignment context.', node: '16:2', heuristic: 'System status · Recognition · Consistency' },
  { number: '02', title: 'Which file will count?', issue: 'The notes raised uncertainty when another submission was added instead of clearly replacing the earlier file.', response: 'Make the chosen file visible before Submit, with a removal control. Replacement after submission remains unresolved.', node: '18:2', heuristic: 'User control and freedom' },
  { number: '03', title: 'What belongs in this rubric cell?', issue: 'An evaluator described repeatedly checking which rubric cell should receive an entry.', response: 'Separate and label criteria, headers, and score, then provide a review state.', node: '9:6', heuristic: 'Aesthetic and minimalist design' },
];
---
<BaseLayout title="D2L Redesign — Collaborative UX case study" description="An MSU team redesign proposal connecting heuristic evaluation, student assignment submission, and instructor workflows. Authentic artifacts; review only.">
  <div id="top"><SiteHeader />
    <main id="main" class="container case-study d2l-case" tabindex="-1">
      <div class="case-intro">
        <header class="case-hero"><a class="case-back" href={`${root}#work`}>← Back to selected work</a><p class="micro">Michigan State University / Collaborative UX &amp; UI</p><h1>{project.data.title}</h1><p class="case-deck">{cs.headline}</p><p class="case-scope">{cs.introduction}</p><dl class="hero-metadata"><div><dt>Context</dt><dd>University team project</dd></div><div><dt>Collaboration</dt><dd>Four-person team</dd></div><div><dt>Scope</dt><dd>Student + instructor UX</dd></div></dl></header>
        <DesktopPair />
      </div>
      <ProjectMetadata items={[
        { label: 'Project', value: cs.context }, { label: 'Team', value: cs.team.join(', ') },
        { label: 'Contribution', value: cs.role }, { label: 'Status', value: 'Redesign proposal · Not launched · Review only' },
      ]} />
      <p class="d2l-status"><strong>Project status.</strong> A collaborative university proposal, not an official D2L release. The work presents evaluator observations and prototype decisions; usability testing and measurable improvements are not established.</p>
      <nav class="case-toc" aria-label="Case study sections"><p class="micro">In this case study</p><ul>{cs.sections.map(section => <li><a href={`#${section.id}`}>{section.kicker.replace(/^\d+ \/ /, '')}</a></li>)}</ul></nav>
      {cs.sections.map(section => <ProcessSection {...section}>
        {section.id === 'evaluation' && <div class="d2l-findings">{findings.map(finding => <article><p class="micro">{finding.number} / Evaluator observation</p><h3>{finding.title}</h3><p>{finding.issue}</p><p class="d2l-response"><strong>Design response.</strong> {finding.response}</p><p class="source-note">{finding.heuristic}<br /><a href={source(finding.node)}>Original evaluation · {finding.node}</a></p></article>)}</div>}
        {section.id === 'workflows' && <div class="d2l-flow-grid"><div><h3>Student / Review before submitting</h3><p class="d2l-transcript">Select a course → Assignments → open an assignment → add or drag a file → review → confirm or go back → Submit → confirmation. The original diagram also includes a quiz branch.</p><ArtifactFigure asset={assets.studentFlow} /></div><div><h3>Instructor / Define, publish, review</h3><p class="d2l-transcript">Open the course → create an assignment → add details and criteria → attach supporting files → publish → grade → send feedback.</p><ArtifactFigure asset={assets.instructorFlow} /></div></div>}
        {section.id === 'exploration' && <>
          <div class="d2l-sketch-grid"><ArtifactFigure asset={assets.studentSketch} /><ArtifactFigure asset={assets.instructorSketch} /></div>
          <div class="d2l-iteration" role="group" aria-label="Earlier and final assignment prototype comparison"><div><h3>01 / Earlier assignment</h3><ArtifactFigure asset={assets.earlier} /></div><div><h3>02 / Final assignment</h3><ArtifactFigure asset={assets.assignment} /></div></div>
          <p class="d2l-comparison-note">Same task, retained layout. The visible change is populated directions and comment-editor controls—not evidence of improved task completion.</p>
        </>}
        {section.id === 'experience' && <>
          <div class="d2l-student-sequence" role="group" aria-label="Selected-file review and separate submission-history concepts"><div><h3>Student / Review the chosen file</h3><ArtifactFigure asset={assets.file} /></div><div><h3>Student / Check the record</h3><ArtifactFigure asset={assets.history} /></div></div>
          <div class="d2l-instructor"><div><p class="micro">The other side of coursework</p><h3>Define the criteria before grading.</h3><p>The instructor overview introduces requirements and dates. The rubric maker gives criteria, headers, and score separate labels, with template, draft, and save actions.</p><p class="source-note"><a href={source('274:488')}>Original grading and submission settings · 274:488</a></p></div><ArtifactFigure asset={assets.rubric} /></div>
          <aside class="d2l-limits" aria-labelledby="limits-heading"><p class="micro">Prototype questions / Still open</p><h3 id="limits-heading">The proposal has edges to resolve.</h3><ul><li>The selected-file screen supports removal before submission; replacing a file after submission is not established.</li><li>The confirmation overlay still has “Not Submitted” beneath it. An empty-file state also links to confirmation.</li><li>One reached assignment-list variant lacks an onward assignment link. The history view exists on another path; a complete end-to-end route is not established.</li><li>Dates and points vary between states, and a student course frame includes a New Announcement control. Role boundaries, validation, error recovery, and keyboard/screen-reader behavior need evaluation.</li></ul><p class="source-note"><a href={source('554:550')}>Inspect the original student prototype</a>. File upload, confirmation email, and publication are interface concepts, not operating services.</p></aside>
        </>}
        {section.id === 'reflection' && <div class="next-priorities" aria-label="Proposed next steps"><div><h3>Validate the student journey</h3><p>Explore discovery, file selection, removal, submission, and history. Resolve contradictory states and prototype connections.</p></div><div><h3>Evaluate instructor setup</h3><p>Examine date meanings, grading and rubric choices, draft versus publish, and feedback delivery.</p></div><div><h3>Review access and recovery</h3><p>Evaluate focus, dialog behavior, labels, contrast, and status announcements, alongside unsupported files, failures, and resubmission.</p></div></div>}
      </ProcessSection>)}
      <section class="case-sources" aria-labelledby="sources-heading"><p class="micro">Shared work / Original sources</p><h2 id="sources-heading">Project Credits &amp; Resources</h2><p>D2L Redesign was developed collaboratively by Suleyman Koncagul, Gabe Bustillo, Benji Fajardo, and Alana Alexander as a Michigan State University team project. All four teammates worked together throughout the design process.</p><ul><li><a href={source('0:1')}>Original heuristic analysis and questions</a></li><li><a href={source('123:2')}>Original student and instructor task flows</a></li><li><a href={source('160:2')}>Original sketches, visual exploration, and style guide</a></li><li><a href={source('554:550')}>Final student high-fidelity prototype</a> · <a href={source('408:935')}>Earlier student prototype</a></li><li><a href={source('241:193')}>Original instructor designs</a></li></ul><p class="source-note">Original designs and colors are preserved. The style guide references Iconscout; embedded imagery, icons, institutional marks, and workbook references require attribution/rights review before public launch. Inspiration references are not presented as team-designed interfaces. Raw interview responses and grading records are not reproduced. Course and term remain unconfirmed.</p><a class="text-link" href={`${root}#work`}>Back to selected work <span aria-hidden="true">↗</span></a></section>
    </main><SiteFooter />
  </div>
</BaseLayout>
