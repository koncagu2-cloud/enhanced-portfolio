---
import { getCollection } from 'astro:content';
import SectionHeading from './SectionHeading.astro';
import D2LFeature from './D2LFeature.astro';
import CommunitySpacesFeature from './CommunitySpacesFeature.astro';
import '../styles/case-study.css';
// Only the two commissioned, source-backed review case studies are featured.
const projects = await getCollection('projects', ({ data }) => data.publicationStatus === 'review' && Boolean(data.caseStudy));
const d2l = projects.find(project => project.id === 'd2l');
const community = projects.find(project => project.id === 'community-spaces');
---
<section id="work" class="section" aria-labelledby="work-heading">
  <SectionHeading number="01" title="Selected work" id="work-heading" note="Two collaborative university projects" />
  <p class="section-intro">Exploring assignment submission in D2L and connecting a community space with event discovery and registration.</p>
  {d2l && <D2LFeature project={d2l} />}
  {community && <CommunitySpacesFeature project={community} />}
</section>
