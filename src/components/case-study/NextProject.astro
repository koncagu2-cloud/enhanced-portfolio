---
interface Props { slug: string; title: string; description: string }
const { slug, title, description } = Astro.props;
---
<nav class="next-project" aria-label="Continue exploring">
  <div><p class="micro">Next project</p><h2>{title}</h2><p>{description}</p></div>
  <a class="text-link" href={`${import.meta.env.BASE_URL}work/${slug}/`}>Explore {title}<span aria-hidden="true">↗</span></a>
</nav>
