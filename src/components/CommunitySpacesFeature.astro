---
import type { CollectionEntry } from 'astro:content';
import { communityAssets } from '../data/community-spaces-assets';
interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props;
const href = `${import.meta.env.BASE_URL}work/${project.data.caseStudy!.slug}/`;
---
<article class="community-feature" aria-labelledby="community-feature-heading">
  <div class="feature-heading"><div><p class="micro">Featured case study / Collaborative class project</p><h3 id="community-feature-heading">{project.data.title}</h3><p>{project.data.provisionalSummary}</p></div><span class="status-label">Concept & prototype · Review only</span></div>
  <a class="feature-artifacts" href={href} aria-label="View the Community Spaces case study">
    {[communityAssets.home, communityAssets.events, communityAssets.confirmation].map((asset) => <img src={asset.image.src} width={asset.image.width} height={asset.image.height} alt={asset.alt} loading="lazy" decoding="async" />)}
  </a>
  <div class="feature-footer"><p>Authentic team-designed Figma screens. Illustrative data; no launch or measured improvement is claimed.</p><a class="text-link" href={href}>Read the case study <span aria-hidden="true">↗</span></a></div>
</article>
