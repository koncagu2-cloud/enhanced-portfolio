---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ProjectMetadata from '../../components/case-study/ProjectMetadata.astro';
import ProcessSection from '../../components/case-study/ProcessSection.astro';
import ArtifactFigure from '../../components/case-study/ArtifactFigure.astro';
import DesktopPair from '../../components/d2l/DesktopPair.astro';
import { d2lAssets as assets } from '../../data/d2l-assets';
import '../../styles/case-study.css';
import '../../styles/d2l.css';
const project = await getEntry('projects', 'd2l');
if (!project?.data.caseStudy || project.data.publicationStatus !== 'review') throw new Error('D2L review content is required.');
const cs = project.data.caseStudy;
const root = import.meta.env.BASE_URL;
const source = (node: string) => `https://www.figma.com/design/piRHnDp4bwoVkKMo1mHSt7/Team--1?node-id=${node.replace(':', '-')}`;
const findings = [
  { number: '01', title: 'Where am I in this course?', issue: 'The evaluator noted that the main navigation did not indicate the current page.', why: 'Without a persistent location cue, students must infer where they are before choosing the next action.', response: 'The assignment concept underlines Assignments and names the assignment above its requirements.', limitation: 'This shows a location cue, not evidence that navigation or consistency across courses improved.', node: '16:2', artifact: '554:1123', artifactLabel: 'Assignment context', heuristic: 'Visibility of system status' },
  { number: '02', title: 'Which file will count?', issue: 'The evaluator described adding another submission without clearly replacing the earlier file.', why: 'The intended final file can become ambiguous for both the student and the instructor.', response: 'The selected-file concept names the chosen PDF and offers removal before Submit.', limitation: 'A partial response: replacing a file after submission remains unresolved. Confirmation and status also conflict in some states.', node: '18:2', artifact: '554:1377', artifactLabel: 'Selected-file review', heuristic: 'User control and freedom' },
  { number: '03', title: 'What belongs in this rubric cell?', issue: 'The evaluator described repeatedly checking which rubric cell should receive an entry.', why: 'Distinguishing criteria from scores matters when instructors prepare grading requirements.', response: 'The rubric-maker concept separates and labels Criteria, Criteria Headers, and Score.', limitation: 'The structure is visible; easier or more accurate rubric authoring has not been demonstrated.', node: '9:6', artifact: '286:415', artifactLabel: 'Rubric structure', heuristic: 'Aesthetic and minimalist design' },
];
---
<BaseLayout title="D2L Redesign — Collaborative UX case study" description="An MSU team redesign proposal connecting heuristic evaluation, student assignment submission, and instructor workflows. Authentic artifacts; review only.">
  <div id="top"><SiteHeader />
    <main id="main" class="container case-study d2l-case" tabindex="-1">
      <div class="case-intro">
        <header class="case-hero"><a class="case-back" href={`${root}#work`}>← Back to selected work</a><p class="micro">Michigan State University / Collaborative UX &amp; UI</p><h1>{project.data.title}</h1><p class="case-deck">{cs.headline}</p><p class="case-scope">{cs.introduction}</p></header>
        <ProjectMetadata items={[
          { label: 'Project', value: cs.context }, { label: 'Team', value: 'Four-person collaborative team' },
          { label: 'Contribution', value: cs.role }, { label: 'Focus', value: 'Student submission / Supporting instructor setup.' },
        ]} />
        <p class="d2l-status"><strong>Project status.</strong> Academic interface proposal; not implemented or launched, and not an official D2L release. Usability testing and measurable improvements are not established. Screen content is illustrative.</p>
        <DesktopPair />
      </div>
      <nav class="case-toc" aria-label="Case study sections"><p class="micro">In this case study</p><ul>{cs.sections.map(section => <li><a href={`#${section.id}`}>{section.kicker.replace(/^\d+ \/ /, '')}</a></li>)}</ul></nav>
      {cs.sections.map(section => <ProcessSection {...section}>
        {section.id === 'challenge' && <div class="d2l-decision-preview"><div class="d2l-priorities" aria-labelledby="priorities-heading"><h3 id="priorities-heading">Three design priorities</h3><dl><div><dt>Assignment context</dt><dd>Bring the requirements into view before choosing a file.</dd></div><div><dt>File selection</dt><dd>Show the chosen filename before submission.</dd></div><div><dt>Submission record</dt><dd>Provide a place to inspect submitted work.</dd></div></dl><a href="#experience">See the proposed student interface states →</a></div><ArtifactFigure asset={assets.file} /></div>}
        {section.id === 'evaluation' && <div class="d2l-findings">{findings.map(finding => <article><p class="micro">{finding.number} / Evaluator observation</p><h3>{finding.title}</h3><p>{finding.issue}</p><p class="d2l-response"><strong>Why it matters.</strong> {finding.why}</p><p class="d2l-response"><strong>Proposed response.</strong> {finding.response}</p><p class="d2l-response"><strong>Still unresolved.</strong> {finding.limitation}</p><p class="source-note">{finding.heuristic}<br /><a href={source(finding.node)}>Original evaluation · {finding.node}</a><br /><a href={source(finding.artifact)}>{finding.artifactLabel} · {finding.artifact}</a></p></article>)}</div>}
        {section.id === 'workflows' && <div class="d2l-flow-grid"><div><h3>Student / Review before submitting</h3><p class="d2l-transcript">Select a course → Assignments → open an assignment → add or drag a file → review → confirm or go back → Submit → confirmation. The original diagram also includes a quiz branch.</p><ArtifactFigure asset={assets.studentFlow} /></div><div><h3>Instructor / Define, publish, review</h3><p class="d2l-transcript">Open the course → create an assignment → add details and criteria → attach supporting files → publish → grade → send feedback.</p><ArtifactFigure asset={assets.instructorFlow} /></div></div>}
        {section.id === 'exploration' && <>
          <div class="d2l-sketch-grid"><ArtifactFigure asset={assets.studentSketch} /><ArtifactFigure asset={assets.instructorSketch} /></div>
          <div class="d2l-iteration" role="group" aria-label="Earlier and final assignment prototype comparison"><div><h3>01 / Earlier assignment</h3><ArtifactFigure asset={assets.earlier} /></div><div><h3>02 / Final assignment</h3><ArtifactFigure asset={assets.assignment} /></div></div>
          <p class="d2l-comparison-note">The layout stayed consistent; the later version populated the directions and added comment-editor controls.</p>
        </>}
        {section.id === 'experience' && <>
          <p class="d2l-sequence-note">Three proposed interface states, shown in task order. They are not a verified, fully connected prototype. File selection leads into review in the task map; the confirmation state and separate history path remain distinct in the source prototype. <a href={source('554:1452')}>Inspect the original confirmation state</a>.</p>
          <ol class="d2l-student-sequence" aria-label="Proposed student journey">
            <li><div class="d2l-step-copy"><p class="micro">01 / Review Assignment Requirements</p><h3>Start with the requirements.</h3><p>The named assignment brings its directions, due date, points, submission type, and status together before adding a file.</p></div><ArtifactFigure asset={assets.assignment} /></li>
            <li><div class="d2l-step-copy"><p class="micro">02 / Review Selected File</p><h3>Check the file before Submit.</h3><p>The chosen filename remains visible, with options to remove it, add a file, or cancel.</p></div><ArtifactFigure asset={assets.file} /></li>
            <li><div class="d2l-step-copy"><p class="micro">03 / Check Submission Record</p><h3>Return to the record.</h3><p>A separate history state shows the file, submission date, and Submitted status.</p></div><ArtifactFigure asset={assets.history} /></li>
          </ol>
          <div class="d2l-instructor"><div><p class="micro">The other side of coursework</p><h3>Define the criteria before grading.</h3><p>What students need to submit depends on the requirements and grading criteria instructors set. Our instructor concept connects that setup to the student journey, giving criteria, headers, and score separate labels in the rubric maker.</p><p class="source-note"><a href={source('274:488')}>Original grading and submission settings · 274:488</a></p></div><ArtifactFigure asset={assets.rubric} /></div>
        </>}
        {section.id === 'reflection' && <div class="next-priorities d2l-reflection-priorities" aria-label="Prototype limitations and proposed next steps"><div><h3>Submission recovery</h3><p>The design shows removal before Submit; replacement after submission remains unresolved. Evaluate wrong-file recovery, unsupported files, and resubmission alongside instructor setup.</p></div><div><h3>Status consistency</h3><p>The confirmation overlay retains “Not Submitted” underneath. Reconcile the displayed states and evaluate whether people understand when their work is recorded.</p></div><div><h3>Complete the connections</h3><p>An assignment-list link is missing, and history sits on a separate path. Connect and evaluate the full journey, including keyboard access and screen-reader feedback.</p></div></div>}

      </ProcessSection>)}
      <section class="case-sources" aria-labelledby="sources-heading"><p class="micro">Shared work / Original sources</p><h2 id="sources-heading">Project Credits &amp; Resources</h2><p>D2L Redesign was developed collaboratively by Suleyman Koncagul, Gabe Bustillo, Benji Fajardo, and Alana Alexander as a Michigan State University team project. All four teammates worked together throughout the design process.</p><ul><li><a href={source('0:1')}>Original heuristic analysis and questions</a></li><li><a href={source('123:2')}>Original student and instructor task flows</a></li><li><a href={source('160:2')}>Original sketches, visual exploration, and style guide</a></li><li><a href={source('554:550')}>Final student high-fidelity prototype</a> · <a href={source('408:935')}>Earlier student prototype</a></li><li><a href={source('241:193')}>Original instructor designs</a></li></ul><p class="source-note">Original designs and colors are preserved. The style guide references Iconscout; embedded imagery, icons, institutional marks, and workbook references require attribution/rights review before public launch. Inspiration references are not presented as team-designed interfaces. Raw interview responses and grading records are not reproduced. Course and term remain unconfirmed.</p><a class="text-link" href={`${root}#work`}>Back to selected work <span aria-hidden="true">↗</span></a></section>
    </main><SiteFooter />
  </div>
</BaseLayout>
