---
import { site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
---
<div class="review-strip">
  <div class="container strip-inner">
    <span>Portfolio V2 <span aria-hidden="true">/</span> Structure study 01</span>
    <span>Provisional content · Not the live portfolio</span>
  </div>
</div>
<header class="container site-header">
  <a class="wordmark" href="#top" aria-label={`${site.name}, back to top`}>Suleyman<br />Koncagul<span aria-hidden="true">.</span></a>
  <nav aria-label="Primary navigation">
    <ul>{site.nav.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}</ul>
  </nav>
  <ThemeToggle />
</header>
