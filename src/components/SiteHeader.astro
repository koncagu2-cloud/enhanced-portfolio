---
import { site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
const homePrefix = Astro.url.pathname === import.meta.env.BASE_URL ? '' : import.meta.env.BASE_URL;
---
<div class="review-strip">
  <div class="container strip-inner">
    <span>Portfolio V2 <span aria-hidden="true">/</span> Review draft</span>
    <span>Not the live portfolio · Not for publication</span>
  </div>
</div>
<header class="container site-header">
  <a class="wordmark" href={`${homePrefix}#top`} aria-label={`${site.name}, homepage`}>Suleyman<br />Koncagul<span aria-hidden="true">.</span></a>
  <nav aria-label="Primary navigation">
    <ul>{site.nav.map(({ label, href }) => <li><a href={`${homePrefix}${href}`}>{label}</a></li>)}</ul>
  </nav>
  <ThemeToggle />
</header>
