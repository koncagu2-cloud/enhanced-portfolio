---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ProjectMetadata from '../../components/case-study/ProjectMetadata.astro';
import ProcessSection from '../../components/case-study/ProcessSection.astro';
import ArtifactFigure from '../../components/case-study/ArtifactFigure.astro';
import DesignComparison from '../../components/case-study/DesignComparison.astro';
import ScreenSequence from '../../components/case-study/ScreenSequence.astro';
import HeroShowcase from '../../components/case-study/HeroShowcase.astro';
import { communityAssets } from '../../data/community-spaces-assets';
import '../../styles/case-study.css';

export async function getStaticPaths() {
  // Only this explicitly commissioned review case study is routable. Other drafts stay out.
  const projects = await getCollection('projects', ({ id, data }) => id === 'community-spaces' && data.publicationStatus === 'review' && Boolean(data.caseStudy));
  return projects.map((project) => ({ params: { slug: project.data.caseStudy!.slug }, props: { project } }));
}
interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props;
const cs = project.data.caseStudy!;
const root = import.meta.env.BASE_URL;
---
<BaseLayout title="Community Spaces — Collaborative UX case study" description="A collaborative GD 491 class concept for a community space and event-registration app. Authentic team artifacts, reported class research, and proposed next steps; review only.">
  <div id="top"><SiteHeader />
    <main id="main" class="container case-study" tabindex="-1">
      <div class="case-intro"><header class="case-hero"><a class="case-back" href={`${root}#work`}>← Back to selected work</a><p class="micro">{cs.context} / UX & interaction design</p><h1>{project.data.title}</h1><p class="case-deck">{cs.headline}</p><p class="case-scope">{cs.introduction}</p><dl class="hero-metadata"><div><dt>Context</dt><dd>GD 491 final</dd></div><div><dt>Collaboration</dt><dd>Four-person team</dd></div><div><dt>Scope</dt><dd>Space + digital UX</dd></div></dl></header>
      <HeroShowcase />
      </div>
      <ProjectMetadata items={[
        { label: 'Project', value: cs.context },
        { label: 'Team', value: cs.team.join(', ') },
        { label: 'My contribution', value: cs.role },
        { label: 'Status', value: 'Concept and prototype · Not launched · Review only' },
      ]} />
      <nav class="case-toc" aria-label="Case study sections"><p class="micro">In this case study</p><ul>{cs.sections.map((section) => <li><a href={`#${section.id}`}>{section.kicker.replace(/^\d+ \/ /, '')}</a></li>)}</ul></nav>
      {cs.sections.map((section) => <ProcessSection {...section}>
        {section.media === 'flow' && <ArtifactFigure asset={communityAssets.flow} />}
        {section.media === 'sketch' && <ArtifactFigure asset={communityAssets.sketch} />}
        {section.media === 'space' && <ArtifactFigure asset={communityAssets.space} />}
        {section.media === 'comparison' && <DesignComparison before={communityAssets.midEvents} after={communityAssets.events} beforeLabel="01 / Structure" afterLabel="02 / Visual development" />}
        {section.media === 'screens' && <ScreenSequence />}
      </ProcessSection>)}
      <section id="sources" class="case-sources" aria-labelledby="sources-heading"><p class="micro">Source notes / Credits</p><h2 id="sources-heading">Grounded in the team’s materials.</h2><p>Team and shared contribution confirmed by Suleyman. Research statements are attributed to the class presentation rather than represented as independently verified findings. Screen colors and illustrative content are preserved as supplied.</p><ul><li><a href="https://www.figma.com/design/pWjqzjZD2HgayCk6pQg3Zk/Wireframes?node-id=154-64">Original wireframes and high-fidelity designs in Figma</a></li><li><a href="https://www.figma.com/design/STtzkQ9AyK3krzZihxnXxt/User-Needs---Concept-Statements?node-id=0-1">Original user needs and concept statements in Figma</a></li><li>Final class presentation: <cite>GD 491 Case Study for Community Spaces</cite>, 17 pages, supplied by the owner. Only relevant project visuals are reproduced; the full deck and raw participant material are not republished.</li></ul><p class="source-note">Class-template credits name Slidesgo, Flaticon, and Freepik. No decorative template illustrations were extracted for this page. Embedded photos and icon rights within the original interface screens still need review before a public launch.</p><a class="text-link" href={`${root}#work`}>Back to selected work <span aria-hidden="true">↗</span></a></section>
    </main><SiteFooter />
  </div>
</BaseLayout>
