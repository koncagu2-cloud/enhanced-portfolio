---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ProjectMetadata from '../../components/case-study/ProjectMetadata.astro';
import ProcessSection from '../../components/case-study/ProcessSection.astro';
import ArtifactFigure from '../../components/case-study/ArtifactFigure.astro';
import DesignComparison from '../../components/case-study/DesignComparison.astro';
import ScreenSequence from '../../components/case-study/ScreenSequence.astro';
import HeroShowcase from '../../components/case-study/HeroShowcase.astro';
import { communityAssets } from '../../data/community-spaces-assets';
import '../../styles/case-study.css';

export async function getStaticPaths() {
  // Only this explicitly commissioned review case study is routable. Other drafts stay out.
  const projects = await getCollection('projects', ({ id, data }) => id === 'community-spaces' && data.publicationStatus === 'review' && Boolean(data.caseStudy));
  return projects.map((project) => ({ params: { slug: project.data.caseStudy!.slug }, props: { project } }));
}
interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props;
const cs = project.data.caseStudy!;
const root = import.meta.env.BASE_URL;
---
<BaseLayout title="Community Spaces — Collaborative UX case study" description="A collaborative GD 491 class concept for a community space and event-registration app. Authentic team artifacts, reported class research, and proposed next steps; review only.">
  <div id="top"><SiteHeader />
    <main id="main" class="container case-study community-case" tabindex="-1">
      <div class="case-intro"><header class="case-hero"><a class="case-back" href={`${root}#work`}>← Back to selected work</a><p class="micro">{cs.context} / UX & interaction design</p><h1>{project.data.title}</h1><p class="case-deck">{cs.headline}</p><p class="case-scope">{cs.introduction}</p><dl class="hero-metadata"><div><dt>Context</dt><dd>GD 491 final</dd></div><div><dt>Collaboration</dt><dd>Four-person team</dd></div><div><dt>Scope</dt><dd>Space + digital UX</dd></div></dl></header>
      <HeroShowcase />
      </div>
      <ProjectMetadata items={[
        { label: 'Project', value: cs.context },
        { label: 'Team', value: cs.team.join(', ') },
        { label: 'My contribution', value: cs.role },
        { label: 'Status', value: 'Concept and prototype · Not launched · Review only' },
      ]} />
      <p class="project-status"><strong>Project status.</strong> University concept and prototype; not launched. Usability evaluation is proposed. Research findings are reported from the class project. Dates, counts, and availability in the original screens are illustrative.</p>
      <nav class="case-toc" aria-label="Case study sections"><p class="micro">In this case study</p><ul>{cs.sections.map((section) => <li><a href={`#${section.id}`}>{section.kicker.replace(/^\d+ \/ /, '')}</a></li>)}</ul></nav>
      {cs.sections.map((section) => <ProcessSection {...section}>
        {section.id === 'research' && <aside class="research-finding" aria-label="Class research finding"><h3>See what’s available before a visit.</h3><p>The team’s digital need statement called for event availability on specific dates. That need is reflected in the calendar, event information, and reservation concepts.</p><p class="source-note">Class presentation, pages 3–4, and original user needs. The class research also reported that ≈9 of 12 participants wanted more music or concert-related entertainment. This is a finding from the small project sample, not a population-level statistic.</p></aside>}
        {section.id === 'experience' && <div class="experience-pair"><div><h3>Physical experience</h3><ul><li>Study areas</li><li>Event spaces</li><li>Community interaction</li><li>Proposed Sparty Market</li></ul></div><div><h3>From discovery to the proposed space</h3><ol class="service-journey"><li>Discover an event</li><li>Review the details</li><li>Register to attend</li><li>Attend at the proposed community space</li></ol><p class="source-note">Explanatory summary of the team’s concept and task flow. The final step describes the intended visit, not observed attendance.</p></div></div>}

        {section.media.includes('space') && <ArtifactFigure asset={communityAssets.space} />}
        {section.media.includes('flow') && <div class="journey"><h3>The path to participation</h3><p>After login, start at home, browse events, open the details, sign up, double-check the choice, and receive confirmation. History, the market, and the shopping cart sit alongside this main path.</p><ArtifactFigure asset={communityAssets.flow} /></div>}
        {section.media.includes('sketch') && <ArtifactFigure asset={communityAssets.sketch} />}
        {section.media.includes('comparison') && <DesignComparison before={communityAssets.midEvents} after={communityAssets.events} beforeLabel="01 / Structure" afterLabel="02 / Visual development" />}
        {section.media.includes('screens') && <ScreenSequence />}
        {section.id === 'reflection' && <div class="next-priorities" aria-label="Proposed next steps"><div><h3>Validate the journey</h3><p>Test event discovery, registration, and confirmation with potential users.</p></div><div><h3>Evaluate accessibility</h3><p>Review navigation, contrast, screen-reader support, and interaction targets.</p></div><div><h3>Explore real-world scenarios</h3><p>Consider canceled events, capacity limits, and whether users should be able to browse without logging in.</p></div></div>}
      </ProcessSection>)}
      <section id="sources" class="case-sources" aria-labelledby="sources-heading"><p class="micro">Source notes / Credits</p><h2 id="sources-heading">Project Credits &amp; Resources</h2><p>Community Spaces was developed collaboratively by Katelyn Jewett, Illiana Gonzalez, Boran Erdogan, and Suleyman Koncagul as a GD 491 final project at Michigan State University. All four teammates worked together throughout the process.</p><ul><li><a href="https://www.figma.com/design/pWjqzjZD2HgayCk6pQg3Zk/Wireframes?node-id=154-64">Original wireframes and high-fidelity designs in Figma</a></li><li><a href="https://www.figma.com/design/STtzkQ9AyK3krzZihxnXxt/User-Needs---Concept-Statements?node-id=0-1">Original user needs and concept statements in Figma</a></li><li>Final class presentation: <cite>GD 491 Case Study for Community Spaces</cite>, 17 pages, supplied by the owner. Selected project artifacts reproduced on this page.</li></ul><p class="source-note">Presentation template credits: Slidesgo, Flaticon, and Freepik. Rights to photos and icons embedded in the original screens remain subject to review before public launch.</p><a class="text-link" href={`${root}#work`}>Back to selected work <span aria-hidden="true">↗</span></a></section>
    </main><SiteFooter />
  </div>
</BaseLayout>
