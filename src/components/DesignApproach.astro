---
import SectionHeading from './SectionHeading.astro';
const principles = [
  { title: 'Understand the problem.', body: 'Examine the existing experience, gather relevant evidence, and identify the questions that matter.' },
  { title: 'Structure the experience.', body: 'Organize information and interactions around the tasks people need to complete.' },
  { title: 'Consider how it works.', body: 'Connect interface decisions with accessibility, responsive behavior, and questions for evaluation.' },
];
---
<section id="approach" class="section" aria-labelledby="approach-heading">
  <SectionHeading number="02" title="Design approach" id="approach-heading" note="Evaluation / Structure / Interaction" />
  <div class="approach-grid">{principles.map((item, i) => <div class="approach-item"><span class="micro">0{i + 1}</span><h3>{item.title}</h3><p>{item.body}</p></div>)}</div>
</section>
