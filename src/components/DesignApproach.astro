---
import SectionHeading from './SectionHeading.astro';
const principles = [
  { title: 'Understand the context.', body: 'Start with the problem, the people involved, and what the evidence can actually tell us.' },
  { title: 'Make the structure clear.', body: 'Organize information around meaningful tasks, then make the next step easier to understand.' },
  { title: 'Test the decisions.', body: 'Evaluate what works, acknowledge limitations, and use what we learn to guide the next iteration.' },
];
---
<section id="approach" class="section" aria-labelledby="approach-heading">
  <SectionHeading number="02" title="Design approach" id="approach-heading" note="Provisional principles" />
  <div class="approach-grid">{principles.map((item, i) => <div class="approach-item"><span class="micro">0{i + 1}</span><h3>{item.title}</h3><p>{item.body}</p></div>)}</div>
</section>
